{
  "manifest_version": 3,
  "name": "Apontamento de Horas",
  "version": "1.0.7",
  "description": "Registra horários de entrada, saída, clientes e tarefas.",
  "permissions": ["storage",
                  "sidePanel"],
  "icons": {
    "16": "./icons/working-time.png",
    "48": "./icons/working-time.png",
    "128": "./icons/working-time.png"
  },
  "action": {
    "default_icon": "./icons/working-time.png"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "./static/background.js"
  }
}