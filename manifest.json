{
  "manifest_version": 3,
  "name": "Apontamento de Horas",
  "version": "1.0.6",
  "description": "Registra horários de entrada, saída, clientes e tarefas.",
  "permissions": ["storage"],
  "icons": {
    "16": "working-time.png",
    "48": "working-time.png",
    "128": "working-time.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "working-time.png"
  }
}